{
    "$schema": "http://json-schema.org/draft-04/schema#",
    "$id": "https://raw.githubusercontent.com/jasm-development/schemas/main/schema/languages.schema.json",
    "description": "JAsm Language Server Error / Warning messages",
    "type": "object",
    "properties": {
        "languages": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "lang": {
                        "type": "string",
                        "minLength": 1
                    },
                    "invalid": {
                        "type": "array",
                        "properties": {
                            "type": "object",
                            "properties": {
                                "name": {
                                    "type": "string",
                                    "minLength": 1
                                },
                                "errc": {
                                    "type": "integer"
                                },
                                "message": {
                                    "type": "string",
                                    "minLenght": 0
                                }
                            },
                            "required": [
                                "name",
                                "errc",
                                "message"
                            ]
                        }
                    },
                    "warnings": {
                        "type": "array",
                        "properties": {
                            "type": "object",
                            "properties": {
                                "name": {
                                    "type": "string",
                                    "minLength": 1
                                },
                                "warnc": {
                                    "type": "integer"
                                },
                                "message": {
                                    "type": "string",
                                    "minLenght": 0
                                }
                            },
                            "required": [
                                "name",
                                "warnc",
                                "message"
                            ]
                        }
                    }
                },
                "required": [
                    "lang",
                    "invalid"
                ]
            },
            "minItems": 1,
            "uniqueItems": true
        }
    },
    "required": [
        "languages"
    ]
}
