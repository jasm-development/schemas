{
  "$schema": "http://json-schema.org/draft-07/schema#",
	"type": "object",
	"properties": {
    "base": {
      "type": "string",
      "description": "Local base path of jasm-mman configs."
    },
    "index": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "description": "Path of the local index file.",
          "default": "{base}/config.json"
        }
      }
    }
  }
}
