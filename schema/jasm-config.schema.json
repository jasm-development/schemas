{
    "$schema": "http://json-schema.org/draft-04/schema#",
    "$id": "https://raw.githubusercontent.com/jasm-development/schemas/main/schema/jasm-config.schema.json",
    "description": "JAsm configuration file for projects",
    "type": "object",
    "properties": {
        "isa": {
            "type": "string",
            "minLength": 1
        },
        "authors": {
            "type": "array",
            "items": {
                "type": "string",
                "minLength": 1,
            },
            "minItems": 1,
            "uniqueItems": true
        },
        "version": {
            "type": "string",
            "minLength": 1
        },
        "exclude": {
            "type": "array",
            "items": {
                "type": "string",
            },
            "uniqueItems": true
        },
        "preamble": {
            "type": "string",
            "minLength": 1
        },
        "entry": {
            "type": "string",
            "description": "Main entry point for the project. All files included here will be assembled as well.",
            "minLength": 1
        },
        "each": {
            "type": "boolean",
            "description": "Treat every file as a single project. Defaults to false.",
            "default": false
        },
        "location": {
            "type": "string",
            "description": "Location to install the built files. Use `<std>` to add it to the standart library. Defaults to `./dependencies`.",
            "default": "./dependencies"
        },
        "root": {
            "type": "string",
            "description": "Location of the root of this project, seen from the total project root.",
            "default": "./"
        },
        "cmd": {
            "type": "object",
            "properties": {
                "debug": {
                    "type": "string",
                    "minLength": 1
                },
                "release": {
                    "type": "string",
                    "minLength": 1
                },
                "test": {
                    "type": "string",
                    "minLenght": 1
                }
            },
            "required": [
                "release"
            ]
        }
    },
    "required": [
        "isa",
        "authors",
        "version"
    ]
}
